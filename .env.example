# Copy to .env and fill in. In production these are provided by Doppler.

# Secrets
TOKEN=
WEBHOOK_TOKEN=
DB_PASSWORD=
IPC_SECRET_KEY=
STEAM_API_KEY=
WEATHER_API_KEY=
TOPGG_TOKEN=

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fumetool
