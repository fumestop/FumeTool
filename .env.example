# Discord
EMBED_COLOR=0xE44C65
WEBHOOK_ID=
COMMUNITY_GUILD_ID=

# IPC
IPC_STANDARD_PORT=10003
IPC_MULTICAST_PORT=20003

# Extensions (comma-separated)
